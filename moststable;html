        function calculateInsights() {
            if (!paperLogs.length) return;

            const absentCount = paperLogs.filter(p => p.absent).length;
            const grouped = { 'Combined Maths': [], 'Chemistry': [], 'Physics': [] };
            paperLogs.filter(p => !p.absent).forEach(p => grouped[p.subject].push(p.marks));

            let highestSub = '';
            let highestVal = -1;
            let lowestSub = '';
            let lowestVal = 101;

            for (const sub in grouped) {
                if (grouped[sub].length) {
                    const avg = grouped[sub].reduce((a,b) => a+b, 0) / grouped[sub].length;
                    if (avg > highestVal) {
                        highestVal = avg;
                        highestSub = sub;
                    }
                    if (avg < lowestVal) {
                        lowestVal = avg;
                        lowestSub = sub;
                    }
                }
            }

            if (highestSub) {
                document.getElementById('insight-strength').innerText = `Excelling in ${highestSub} averaging ${Math.round(highestVal)}%. Optimize advanced essays next.`;
            }
            
            if (absentCount > 0) {
                document.getElementById('insight-weakness').innerText = `Warning: You were absent for ${absentCount} weekly papers. Retrieve these papers from your tutors immediately!`;
            } else if (lowestSub && lowestVal < 65) {
                document.getElementById('insight-weakness').innerText = `Critical push needed in ${lowestSub} (${Math.round(lowestVal)}%). Practice Spaced active recall revision.`;
            } else {
                document.getElementById('insight-weakness').innerText = `Steady performance tracked. Double down on Spaced active recall strategies!`;
            }
        }

