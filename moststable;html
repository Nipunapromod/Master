                    .map(stabilityNormalizeClass)
                    .filter(Boolean)
                    .sort((a, b) => (STABILITY_DAY_NAMES.indexOf(a.day) - STABILITY_DAY_NAMES.indexOf(b.day)) ||
                        ((stabilityParseClassTime(a.time)?.startMinutes ?? 9999) - (stabilityParseClassTime(b.time)?.startMinutes ?? 9999)) ||
                        a.name.localeCompare(b.name));

                if (!sorted.length) {
                    stabilityClassDomCache.forEach(node => node.remove());
                    stabilityClassDomCache.clear();
                    container.innerHTML = '<p class="text-xs text-slate-500 text-center py-4">No scheduled classes logged yet.</p>';
                    stabilityRestoreScroll(container, previousScroll);
                    return;
                }

                const visible = sorted.slice(0, stabilityClassRenderLimit);
                const visibleIds = new Set(visible.map(cls => cls.id));

                visible.forEach(cls => {
                    let node = stabilityClassDomCache.get(cls.id);
                    if (!node) {
                        node = stabilityCreateClassNode(cls);
                        stabilityClassDomCache.set(cls.id, node);
                    }
                    stabilityUpdateClassNode(node, cls);
                    container.appendChild(node);
                });

                [...stabilityClassDomCache.keys()].forEach(id => {
                    if (!visibleIds.has(id)) {
                        stabilityClassDomCache.get(id)?.remove();
                        stabilityClassDomCache.delete(id);
                    }
                });

                const oldMore = container.querySelector('[data-load-more="classes"]');
                if (oldMore) oldMore.remove();
                if (sorted.length > visible.length) {
                    const more = document.createElement('button');
                    more.type = 'button';
                    more.dataset.loadMore = 'classes';
                    more.className = 'w-full text-[10px] font-bold text-emerald-400 hover:text-emerald-300 py-2 rounded-lg bg-slate-950/50 border border-slate-800 transition';
                    more.textContent = `Load ${Math.min(STABILITY_RENDER_CHUNK, sorted.length - visible.length)} more (${visible.length}/${sorted.length})`;
                    container.appendChild(more);
                }

                stabilityRestoreScroll(container, previousScroll);
            }

            function stabilityTaskExists(candidate, ignoreId = null) {
                const normalizedName = stabilityNormalizeText(candidate.name).toLowerCase();
                return taskLogs.some(task => {
                    if (ignoreId && task.id === ignoreId) return false;
                    return stabilityNormalizeText(task.name).toLowerCase() === normalizedName &&
                        task.date === candidate.date &&
                        task.time === candidate.time;
                });
            }

            function stabilityClassSegments(day, time) {
                const parsed = stabilityParseClassTime(time);
                if (!parsed) return [];
                const dayIndex = STABILITY_DAY_NAMES.indexOf(day);
                if (dayIndex < 0) return [];
                if (!parsed.crossesMidnight) {
                    return [{ dayIndex, start: parsed.startMinutes, end: parsed.endMinutes }];
                }
                return [
                    { dayIndex, start: parsed.startMinutes, end: 1440 },
                    { dayIndex: (dayIndex + 1) % 7, start: 0, end: parsed.endMinutes }
                ];
            }

            function stabilitySegmentsOverlap(a, b) {
                return a.dayIndex === b.dayIndex && Math.max(a.start, b.start) < Math.min(a.end, b.end);
            }

            function stabilityClassHasConflict(candidate, ignoreId = null) {
                const candidateSegments = stabilityClassSegments(candidate.day, candidate.time);
                return classLogs.some(existing => {
                    if (ignoreId && existing.id === ignoreId) return false;
                    const existingSegments = stabilityClassSegments(existing.day, existing.time);
                    return candidateSegments.some(a => existingSegments.some(b => stabilitySegmentsOverlap(a, b)));
                });
            }

            function stabilityClassDuplicateExists(candidate, ignoreId = null) {
                const targetName = stabilityNormalizeText(candidate.name).toLowerCase();
                return classLogs.some(existing => {
                    if (ignoreId && existing.id === ignoreId) return false;
                    return stabilityNormalizeText(existing.name).toLowerCase() === targetName &&
                        existing.day === candidate.day &&
                        existing.time === candidate.time;
                });
            }

            function stabilityEnqueueMutation(entity, action, id, data) {
                const ops = Array.isArray(stabilityCache.pendingOps) ? stabilityCache.pendingOps : [];
                const index = ops.findIndex(op => op.entity === entity && op.id === id);

                if (action === 'insert') {
                    if (index >= 0) {
                        ops[index] = { ...ops[index], action: 'insert', data: { ...(ops[index].data || {}), ...(data || {}) }, updatedAt: Date.now() };
                    } else {
                        ops.push({ opId: stabilityUuid('op'), entity, action, id, data: { ...(data || {}) }, createdAt: Date.now() });
                    }
                } else if (action === 'update') {
                    if (index >= 0 && ops[index].action === 'insert') {
                        ops[index] = { ...ops[index], data: { ...(ops[index].data || {}), ...(data || {}) }, updatedAt: Date.now() };
                    } else if (index >= 0 && ops[index].action === 'update') {
                        ops[index] = { ...ops[index], data: { ...(ops[index].data || {}), ...(data || {}) }, updatedAt: Date.now() };
                    } else if (index < 0) {
                        ops.push({ opId: stabilityUuid('op'), entity, action, id, data: { ...(data || {}) }, createdAt: Date.now() });
                    }
                } else if (action === 'delete') {
                    if (index >= 0 && ops[index].action === 'insert') {
                        ops.splice(index, 1);
                    } else {
                        for (let i = ops.length - 1; i >= 0; i--) {
                            if (ops[i].entity === entity && ops[i].id === id && ops[i].action === 'update') ops.splice(i, 1);
                        }
                        if (!ops.some(op => op.entity === entity && op.id === id && op.action === 'delete')) {
                            ops.push({ opId: stabilityUuid('op'), entity, action, id, data: {}, createdAt: Date.now() });
                        }
                    }
                }

                stabilityCache.pendingOps = ops;
                stabilityScheduleCacheWrite();
            }

            function stabilityApplyLocalTask(task) {
                const normalized = stabilityNormalizeTask(task);
                if (!normalized) return;
                const index = taskLogs.findIndex(item => item.id === normalized.id);
                if (index >= 0) taskLogs[index] = { ...taskLogs[index], ...normalized };
                else taskLogs.push(normalized);
            }

            function stabilityApplyLocalClass(cls) {
                const normalized = stabilityNormalizeClass(cls);
                if (!normalized) return;
                const index = classLogs.findIndex(item => item.id === normalized.id);
                if (index >= 0) classLogs[index] = { ...classLogs[index], ...normalized };
                else classLogs.push(normalized);
            }

            function stabilityRemoveLocal(entity, id) {
                if (entity === 'task') taskLogs = taskLogs.filter(item => item.id !== id);
                if (entity === 'class') classLogs = classLogs.filter(item => item.id !== id);
            }

            function stabilityApplyPendingToLoadedData() {
                const ops = Array.isArray(stabilityCache.pendingOps) ? stabilityCache.pendingOps : [];
                for (const op of ops) {
                    if (!op || !op.entity || !op.action) continue;
                    if (op.entity === 'task') {
                        if (op.action === 'insert') stabilityApplyLocalTask(op.data);
                        else if (op.action === 'update') stabilityApplyLocalTask({ ...(taskLogs.find(item => item.id === op.id) || {}), id: op.id, ...op.data });
                        else if (op.action === 'delete') stabilityRemoveLocal('task', op.id);
                    }
                    if (op.entity === 'class') {
                        if (op.action === 'insert') stabilityApplyLocalClass(op.data);
                        else if (op.action === 'update') stabilityApplyLocalClass({ ...(classLogs.find(item => item.id === op.id) || {}), id: op.id, ...op.data });
                        else if (op.action === 'delete') stabilityRemoveLocal('class', op.id);
                    }
                }
            }

            function stabilityIsRetryableError(err) {
                const status = Number(err?.status || err?.code || 0);
                const message = stabilitySafeString(err?.message).toLowerCase();
                return status === 0 || status === 408 || status === 409 || status === 429 || status >= 500 ||
                    /network|fetch|timeout|timed out|offline|failed to fetch|connection/i.test(message);
            }

            async function stabilityWithRetry(operation, attempts = STABILITY_NETWORK_RETRIES) {
                let lastError = null;
                let delay = STABILITY_RETRY_BASE_DELAY;
                for (let attempt = 1; attempt <= attempts; attempt++) {
                    try {
                        return await operation();
                    } catch (err) {
                        lastError = err;
                        if (!stabilityIsRetryableError(err) || attempt >= attempts) throw err;
                        await new Promise(resolve => setTimeout(resolve, delay));
                        delay *= 2;
                    }
                }
                throw lastError || new Error('Operation failed.');
            }

            async function stabilityCloudMutation(entity, action, id, data = {}) {
                if (!supabaseClient) throw new Error('Cloud service is unavailable.');
                const userId = stabilityGetUserId();
                if (!userId) throw new Error('No authenticated user is available.');
                const table = entity === 'task' ? 'tasks' : 'classes';

                return stabilityWithRetry(async () => {
                    if (action === 'insert') {
                        const payload = { ...data, user_id: userId };
                        delete payload.id;
                        const { data: rows, error } = await supabaseClient.from(table).insert([payload]).select();
                        if (error) throw error;
                        return rows?.[0] || null;
                    }
                    if (action === 'update') {
                        const payload = { ...data };
                        delete payload.user_id;
                        const { data: rows, error } = await supabaseClient.from(table).update(payload).eq('id', id).eq('user_id', userId).select();
                        if (error) throw error;
                        return rows?.[0] || { id, ...payload };
                    }
                    if (action === 'delete') {
                        const { error } = await supabaseClient.from(table).delete().eq('id', id).eq('user_id', userId);
                        if (error) throw error;
                        return { id };
                    }
                    throw new Error(`Unsupported ${entity} action.`);
                });
            }

            function stabilityRemapPendingId(oldId, newId, entity) {
                stabilityCache.pendingOps = (stabilityCache.pendingOps || []).map(op => {
                    if (op.entity === entity && op.id === oldId) return { ...op, id: newId };
                    return op;
                });
            }

            async function stabilityFlushPendingMutations() {
                if (!supabaseClient || !stabilityGetUserId() || navigator.onLine === false) return;
                if (!Array.isArray(stabilityCache.pendingOps) || !stabilityCache.pendingOps.length) return;
                if (stabilityPendingRetryTimer) {
                    clearTimeout(stabilityPendingRetryTimer);
                    stabilityPendingRetryTimer = null;
                }

                const queue = [...stabilityCache.pendingOps];
                let hadFailure = false;

                for (const op of queue) {
                    try {
                        const result = await stabilityCloudMutation(op.entity, op.action, op.id, op.data || {});
                        const idx = stabilityCache.pendingOps.findIndex(item => item.opId === op.opId);
                        if (idx >= 0) stabilityCache.pendingOps.splice(idx, 1);

                        if (op.action === 'insert' && result?.id && result.id !== op.id) {
                            if (op.entity === 'task') {
                                taskLogs = taskLogs.map(item => item.id === op.id ? stabilityNormalizeTask({ ...item, ...result, id: result.id }) : item);
                            } else if (op.entity === 'class') {
                                classLogs = classLogs.map(item => item.id === op.id ? stabilityNormalizeClass({ ...item, ...result, id: result.id }) : item);
                            }
                            stabilityRemapPendingId(op.id, result.id, op.entity);
                        }
                    } catch (err) {
                        hadFailure = true;
                        if (!stabilityIsRetryableError(err)) {
                            const idx = stabilityCache.pendingOps.findIndex(item => item.opId === op.opId);
                            if (idx >= 0) stabilityCache.pendingOps.splice(idx, 1);
                            console.warn(`Permanent cloud sync failure for ${op.entity}/${op.action}. Keeping local data.`, err);
                        } else {
                            break;
                        }
                    }
                }

                stabilityScheduleCacheWrite();
                stabilityRenderTasks({ force: true });
                stabilityRenderClasses({ force: true });
                stabilityScheduleNotifications();

                if (hadFailure && stabilityCache.pendingOps.length) {
                    const delay = Math.min(30000, STABILITY_RETRY_BASE_DELAY * Math.max(1, stabilityCache.pendingOps.length));
                    stabilityPendingRetryTimer = setTimeout(() => {
                        stabilityPendingRetryTimer = null;
                        stabilityFlushPendingMutations().catch(err => console.warn('Pending sync retry failed.', err));
                    }, delay);
                }
            }

            async function stabilityLoadCloudData() {
                stabilitySetTaskLoading(true);
                stabilitySetClassLoading(true);
                stabilityLoadCache();

                const cachedTasks = [...stabilityCache.tasks];
                const cachedClasses = [...stabilityCache.classes];
                let taskFetchSucceeded = false;
                let classFetchSucceeded = false;

                try {
                    if (!supabaseClient) throw new Error('Supabase is not configured.');
                    const { data: { user } } = await supabaseClient.auth.getUser();
                    if (!user) throw new Error('No signed-in user found.');
                    currentUserSession = currentUserSession || { user };

                    try {
                        const { data: profileData, error: profileError } = await stabilityWithRetry(() => supabaseClient.from('profiles').select('*').eq('id', user.id).single(), 2);
                        if (!profileError && profileData) {
                            studentProfile = {
                                name: profileData.name || studentProfile.name,
                                year: profileData.year || studentProfile.year,
                                course: profileData.course || studentProfile.course,
                                district: profileData.district || studentProfile.district,
                                gemini_api_key: profileData.gemini_api_key || ''
                            };
                            if (profileData.gemini_api_key) {
                                try { localStorage.setItem('gemini_api_key', profileData.gemini_api_key); } catch (_) {}
                            }
                        }
                    } catch (err) {
                        console.warn('Profile sync skipped.', err);
                    }

                    const results = await Promise.allSettled([
                        stabilityWithRetry(() => supabaseClient.from('papers').select('*').eq('user_id', user.id), 2),
                        stabilityWithRetry(() => supabaseClient.from('tasks').select('*').eq('user_id', user.id), 2),
                        stabilityWithRetry(() => supabaseClient.from('classes').select('*').eq('user_id', user.id), 2),
                        stabilityWithRetry(() => supabaseClient.from('recalls').select('*').eq('user_id', user.id), 2)
                    ]);

                    const [paperResult, taskResult, classResult, recallResult] = results;

                    if (paperResult.status === 'fulfilled' && !paperResult.value.error) {
                        paperLogs = Array.isArray(paperResult.value.data) ? paperResult.value.data : [];
                    }

                    if (taskResult.status === 'fulfilled' && !taskResult.value.error) {
                        taskLogs = stabilityDedupeById(taskResult.value.data, stabilityNormalizeTask);
                        taskFetchSucceeded = true;
                    } else {
                        taskLogs = stabilityDedupeById(cachedTasks, stabilityNormalizeTask);
                    }

                    if (classResult.status === 'fulfilled' && !classResult.value.error) {
                        classLogs = stabilityDedupeById(classResult.value.data, stabilityNormalizeClass);
                        classFetchSucceeded = true;
                    } else {
                        classLogs = stabilityDedupeById(cachedClasses, stabilityNormalizeClass);
                    }

                    if (recallResult.status === 'fulfilled' && !recallResult.value.error) {
                        recallLogs = Array.isArray(recallResult.value.data) ? recallResult.value.data : [];
                    }

                    stabilityApplyPendingToLoadedData();
                    stabilityCache.tasks = [...taskLogs];
                    stabilityCache.classes = [...classLogs];
                    stabilityScheduleCacheWrite();
                    await stabilityFlushPendingMutations();

                    if (!taskFetchSucceeded && cachedTasks.length) {
                        stabilityInlineStatus(document.getElementById('task-list-container'), 'Cloud tasks could not be refreshed. Showing the latest safe local copy while retrying.', 'error');
                    }
                    if (!classFetchSucceeded && cachedClasses.length) {
                        stabilityInlineStatus(document.getElementById('classes-list-container'), 'Cloud class reminders could not be refreshed. Showing the latest safe local copy while retrying.', 'error');
                    }
                } catch (err) {
                    console.error('Stable cloud data load failed:', err);
                    taskLogs = stabilityDedupeById(cachedTasks, stabilityNormalizeTask);
                    classLogs = stabilityDedupeById(cachedClasses, stabilityNormalizeClass);
                    stabilityApplyPendingToLoadedData();
                    stabilityInlineStatus(document.getElementById('task-list-container'), 'Offline mode: using your latest locally saved tasks. Cloud sync will retry automatically.', 'error');
                    stabilityInlineStatus(document.getElementById('classes-list-container'), 'Offline mode: using your latest locally saved class reminders. Cloud sync will retry automatically.', 'error');
                } finally {
                    stabilitySetTaskLoading(false);
                    stabilitySetClassLoading(false);
                    stabilityRenderTasks({ force: true });
                    stabilityRenderClasses({ force: true });
                    stabilityScheduleNotifications();
                    stabilityScheduleCacheWrite();
                }
            }

            async function stabilityCheckSessionStatus() {
                stabilityDetectStorage();
                stabilityLoadCache();
                try {
                    if (typeof initSupabase === 'function') initSupabase();
                } catch (err) {
                    console.warn('Supabase initialization failed safely.', err);
                }

                if (!supabaseClient) {
                    stabilitySetTaskLoading(false);
                    stabilitySetClassLoading(false);
                    taskLogs = stabilityDedupeById(stabilityCache.tasks, stabilityNormalizeTask);
                    classLogs = stabilityDedupeById(stabilityCache.classes, stabilityNormalizeClass);
                    stabilityRenderTasks({ force: true });
                    stabilityRenderClasses({ force: true });
                    const auth = document.getElementById('auth-screen');
                    if (auth) auth.classList.remove('hidden');
                    return;
                }

                try {
                    const { data: { session } } = await supabaseClient.auth.getSession();
                    if (session?.user) {
                        if (!validateSevenDaySession()) return;
                        currentUserSession = session;
                        if (!getSevenDaySessionExpiry()) setSevenDaySessionExpiry();
                        await stabilityLoadCloudData();
                        const auth = document.getElementById('auth-screen');
                        if (auth) auth.classList.add('hidden');
                        if (typeof syncProfileUI === 'function') syncProfileUI();
                        if (typeof updateCoreStats === 'function') updateCoreStats();
                        return;
                    }
                } catch (err) {
                    console.warn('Session restore failed safely.', err);
                    taskLogs = stabilityDedupeById(stabilityCache.tasks, stabilityNormalizeTask);
                    classLogs = stabilityDedupeById(stabilityCache.classes, stabilityNormalizeClass);
                    stabilityRenderTasks({ force: true });
                    stabilityRenderClasses({ force: true });
                }

                const auth = document.getElementById('auth-screen');
                if (auth) auth.classList.remove('hidden');
            }

            function stabilitySetTaskEditMode(task) {
                stabilityEditingTaskId = task.id;
                stabilityFormControl('task-name').value = task.name;
                stabilityFormControl('task-date').value = task.date;
                const parsed = stabilityParseTaskTime(task.time);
                if (parsed) {
                    const startHour = ((Math.floor(parsed.startMinutes / 60) + 11) % 12) + 1;
                    const startAM = parsed.startMinutes < 720 ? 'AM' : 'PM';
                    const endClock = parsed.endMinutes % 1440;
                    const endHour = ((Math.floor(endClock / 60) + 11) % 12) + 1;
                    const endAM = endClock < 720 ? 'AM' : 'PM';
                    const startHourEl = stabilityFormControl('task-start-hour');
                    const startAmEl = stabilityFormControl('task-start-ampm');
                    const endHourEl = stabilityFormControl('task-end-hour');
                    const endAmEl = stabilityFormControl('task-end-ampm');
                    if (startHourEl) startHourEl.value = String(startHour).padStart(2, '0');
                    if (startAmEl) startAmEl.value = startAM;
                    if (endHourEl) endHourEl.value = String(endHour).padStart(2, '0');
                    if (endAmEl) endAmEl.value = endAM;
                }
                const button = document.getElementById('task-submit-button');
                const cancel = document.getElementById('task-cancel-edit');
                if (button) button.textContent = 'Update Task';
                if (cancel) cancel.classList.remove('hidden');
                stabilityFormControl('task-name')?.focus();
            }

            function stabilityCancelTaskEdit() {
                stabilityEditingTaskId = null;
                const form = document.getElementById('task-form');
                if (form) form.reset();
                const button = document.getElementById('task-submit-button');
                const cancel = document.getElementById('task-cancel-edit');
                if (button) button.textContent = 'Add Task';
                if (cancel) cancel.classList.add('hidden');
            }

            async function stabilityAddTask(event) {
                event?.preventDefault?.();
                if (stabilityTaskSaveInProgress) return;

                const nameEl = stabilityFormControl('task-name');
                const dateEl = stabilityFormControl('task-date');
                const startHourEl = stabilityFormControl('task-start-hour');
                const startAmEl = stabilityFormControl('task-start-ampm');
                const endHourEl = stabilityFormControl('task-end-hour');
                const endAmEl = stabilityFormControl('task-end-ampm');
                if (!nameEl || !dateEl || !startHourEl || !startAmEl || !endHourEl || !endAmEl) {
                    stabilityNotify('Task Error', 'The task form could not be loaded correctly. Please refresh the page.');
                    return;
                }

                const name = stabilityNormalizeText(nameEl.value);
                const date = dateEl.value;
                const startMinutes = stabilityParse12Hour(startHourEl.value, startAmEl.value);
                const endMinutes = stabilityParse12Hour(endHourEl.value, endAmEl.value);
                const time = stabilityFormatTimeRange(startHourEl.value, startAmEl.value, endHourEl.value, endAmEl.value);

                if (!name) {
                    stabilityNotify('Invalid Task', 'Task name cannot be empty or only whitespace.');
                    nameEl.focus();
                    return;
                }
                if (!stabilityDateIsValid(date)) {
                    stabilityNotify('Invalid Date', 'Please select a valid task date.');
                    dateEl.focus();
                    return;
                }
                if (startMinutes === null || endMinutes === null || startMinutes === endMinutes) {
                    stabilityNotify('Invalid Time', 'Please select a valid start and end time. Start and end cannot be identical.');
                    return;
                }

                const editingId = stabilityEditingTaskId;
                const candidate = { id: editingId || stabilityUuid('task'), name, date, time, done: editingId ? Boolean(taskLogs.find(t => t.id === editingId)?.done) : false };
                if (stabilityTaskExists(candidate, editingId)) {
                    stabilityNotify('Duplicate Task', 'That task already exists with the same name, date, and time.');
                    return;
                }

                stabilityTaskSaveInProgress = true;
                stabilitySetFormBusy('task-form', 'task-submit-button', true, editingId ? 'Saving…' : 'Adding…', editingId ? 'Update Task' : 'Add Task');

                try {
                    if (editingId) {
                        stabilityApplyLocalTask(candidate);
                        stabilityEnqueueMutation('task', 'update', editingId, { name, date, time, done: candidate.done });
                        try {
                            const cloud = await stabilityCloudMutation('task', 'update', editingId, { name, date, time, done: candidate.done });
                            if (cloud?.id) stabilityApplyLocalTask({ ...candidate, ...cloud, id: cloud.id });
                            stabilityCache.pendingOps = stabilityCache.pendingOps.filter(op => !(op.entity === 'task' && op.id === editingId && op.action === 'update'));
                        } catch (err) {
                            if (!stabilityIsRetryableError(err)) {
                                stabilityCache.pendingOps = stabilityCache.pendingOps.filter(op => !(op.entity === 'task' && op.id === editingId && op.action === 'update'));
                                stabilityNotify('Saved Locally', 'The task was updated on this device. Cloud sync could not be completed because the server rejected the request.');
                            }
                        }
                    } else {
                        stabilityApplyLocalTask(candidate);
                        try {
                            const cloud = await stabilityCloudMutation('task', 'insert', candidate.id, { name, date, time, done: false });
                            if (cloud?.id && cloud.id !== candidate.id) {
                                taskLogs = taskLogs.map(item => item.id === candidate.id ? stabilityNormalizeTask({ ...candidate, ...cloud, id: cloud.id }) : item);
                                stabilityCache.pendingOps = stabilityCache.pendingOps.filter(op => !(op.entity === 'task' && op.id === candidate.id && op.action === 'insert'));
                            }
                        } catch (err) {
                            stabilityEnqueueMutation('task', 'insert', candidate.id, candidate);
                        }
                    }

                    stabilityCache.tasks = [...taskLogs];
                    stabilityScheduleCacheWrite();
                    stabilityRenderTasks({ force: true });
                    if (typeof updateCoreStats === 'function') updateCoreStats();
                    stabilityCancelTaskEdit();
                    const form = document.getElementById('task-form');
                    if (form) form.reset();
                } catch (err) {
                    console.error('Task save failed safely.', err);
                    stabilityNotify('Task Save Error', 'The task could not be saved. Your existing data was left untouched.');
                } finally {
                    stabilityTaskSaveInProgress = false;
                    stabilitySetFormBusy('task-form', 'task-submit-button', false, '', stabilityEditingTaskId ? 'Update Task' : 'Add Task');
                    const button = document.getElementById('task-submit-button');
                    if (button) button.textContent = stabilityEditingTaskId ? 'Update Task' : 'Add Task';
                    const cancel = document.getElementById('task-cancel-edit');
                    if (!stabilityEditingTaskId && cancel) cancel.classList.add('hidden');
                    stabilityFlushPendingMutations().catch(err => console.warn('Task retry sync failed.', err));
                }
            }

            async function stabilityToggleTask(id) {
                const task = taskLogs.find(item => item.id === id);
                if (!task) return;
                const nextDone = !Boolean(task.done);
                taskLogs = taskLogs.map(item => item.id === id ? { ...item, done: nextDone } : item);
                stabilityRenderTasks({ force: true });
                stabilityCache.tasks = [...taskLogs];
                stabilityEnqueueMutation('task', 'update', id, { done: nextDone });
                try {
                    await stabilityCloudMutation('task', 'update', id, { done: nextDone });
                    stabilityCache.pendingOps = stabilityCache.pendingOps.filter(op => !(op.entity === 'task' && op.id === id && op.action === 'update'));
                } catch (err) {
                    if (!stabilityIsRetryableError(err)) {
                        stabilityCache.pendingOps = stabilityCache.pendingOps.filter(op => !(op.entity === 'task' && op.id === id && op.action === 'update'));
                        stabilityNotify('Saved Locally', 'Completion status was saved locally because the cloud rejected the update.');
                    }
                }
                stabilityScheduleCacheWrite();
                if (typeof updateCoreStats === 'function') updateCoreStats();
                stabilityFlushPendingMutations().catch(err => console.warn('Task completion retry failed.', err));
            }

            async function stabilityDeleteTask(id) {
                const task = taskLogs.find(item => item.id === id);
