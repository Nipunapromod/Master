                : `<div class="bg-indigo-600/10 border border-indigo-500/20 p-2.5 rounded-xl text-indigo-400 mt-0.5 order-2"><i class="fa-solid fa-user"></i></div>`;

            const contentHtml = `
                <div class="${isAI ? 'bg-slate-950 border border-slate-800' : 'bg-brand-900/40 border border-brand-700/30'} rounded-2xl p-4 text-xs ${isAI ? 'text-slate-300' : 'text-slate-200'} leading-relaxed ${!isAI ? 'order-1' : ''}">
                    <p class="font-bold text-white mb-1.5">${isAI ? 'Mastermind AI Advisor' : 'You'}</p>
                    <div class="math-content">${formatMessageText(text)}</div>
                </div>
            `;

            wrapper.innerHTML = avatarHtml + contentHtml;
            chatOutput.appendChild(wrapper);
            triggerMathRender(wrapper);
            chatOutput.scrollTop = chatOutput.scrollHeight;
        }

        async function submitAIChat(event) {
            if (event) event.preventDefault();
            const inputField = document.getElementById('ai-chat-input');
            if (!inputField) return;
            const query = inputField.value.trim();
            if (!query) return;

            inputField.value = '';
            addChatHistory('user', query, false);

            const loader = document.getElementById('ai-loading');
            if (loader) loader.classList.remove('hidden');

            const aiTypingElement = createAIPlaceholderMessage();
            try {
                const aiResponse = await makeAICall(query);
                if (loader) loader.classList.add('hidden');
                if (aiTypingElement) {
                    await typeAIResponse(aiTypingElement, aiResponse);
                    aiChatHistory.push({ sender: 'ai', text: aiResponse, isAI: true, timestamp: Date.now() });
                    saveAIChatHistory();
                } else {
                    addChatHistory('ai', aiResponse, true);
                }
            } catch (err) {
                if (loader) loader.classList.add('hidden');
                console.error('Gemini chat failed:', err);
                const errorText = `Gemini error: ${err?.message || 'Unknown request failure.'}`;
                if (aiTypingElement) {
                    const wrapper = aiTypingElement.closest('.flex');
                    if (wrapper) wrapper.remove();
                    addChatHistory('ai', errorText, true);
                } else {
                    addChatHistory('ai', errorText, true);
                }
            }
        }

