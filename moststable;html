        async function loadCloudData() {
            if (!supabaseClient) return;
            try {
                const { data: { user } } = await supabaseClient.auth.getUser();
                if (!user) return;

                const { data: profileData } = await supabaseClient.from('profiles').select('*').eq('id', user.id).single();
