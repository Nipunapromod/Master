                const period = stabilitySafeString(ampm).toUpperCase();
                if (!Number.isInteger(h) || h < 1 || h > 12 || !['AM', 'PM'].includes(period)) return null;
                return ((h % 12) + (period === 'PM' ? 12 : 0)) * 60;
            }

            function stabilityParseTimePart(hourText, minuteText, ampmText) {
                const hour = Number.parseInt(hourText, 10);
                const minute = Number.parseInt(minuteText ?? '0', 10);
                const period = stabilitySafeString(ampmText).toUpperCase();
                if (!Number.isInteger(hour) || hour < 1 || hour > 12) return null;
                if (!Number.isInteger(minute) || minute < 0 || minute > 59) return null;
                if (!['AM', 'PM'].includes(period)) return null;
                return ((hour % 12) + (period === 'PM' ? 12 : 0)) * 60 + minute;
            }

            function stabilityFormatTimeRange(startH, startAM, endH, endAM) {
                return `${String(startH).padStart(2, '0')}:00 ${stabilitySafeString(startAM).toUpperCase()} - ${String(endH).padStart(2, '0')}:00 ${stabilitySafeString(endAM).toUpperCase()}`;
