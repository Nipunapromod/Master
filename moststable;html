            const tabRegister = document.getElementById('auth-tab-register');
            const form = document.getElementById('auth-form');
            const googleButton = document.getElementById('google-auth-button');

            const isRegistering = currentAuthMode === 'register';
            const idleLabel = isRegistering ? 'Create Account' : 'Sign In';
            const loadingLabel = isRegistering ? 'Creating Account...' : 'Signing In...';

            if (submitButton) submitButton.disabled = isLoading;
            if (submitLabel) submitLabel.innerText = isLoading ? loadingLabel : idleLabel;
            if (submitSpinner) submitSpinner.classList.toggle('hidden', !isLoading);
            if (submitIcon) submitIcon.classList.toggle('hidden', isLoading);
            if (loadingOverlay) loadingOverlay.classList.toggle('hidden', !isLoading);

            if (loadingTitle) {
                loadingTitle.innerText = isRegistering ? 'Creating Your Account' : 'Signing You In';
            }
            if (loadingMessage) {
                loadingMessage.innerText = isRegistering
                    ? 'Setting up your secure student profile...'
                    : 'Connecting securely to your account...';
            }

            if (tabLogin) tabLogin.disabled = isLoading;
            if (tabRegister) tabRegister.disabled = isLoading;
            if (googleButton) googleButton.disabled = isLoading;

            if (form) {
                form.querySelectorAll('input, select').forEach(control => {
                    control.disabled = isLoading;
                });
            }
        }

        function toggleAuthMode(mode) {
            if (authRequestInProgress) return;
            currentAuthMode = mode;
            const regFields = document.getElementById('register-fields');
            const submitLbl = document.getElementById('auth-submit-label');
            const tabLogin = document.getElementById('auth-tab-login');
            const tabRegister = document.getElementById('auth-tab-register');

            if (mode === 'register') {
                if (regFields) regFields.classList.remove('hidden');
                if (submitLbl) submitLbl.innerText = 'Create Account';
                if (tabRegister) tabRegister.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-brand-600 text-white";
                if (tabLogin) tabLogin.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all text-slate-400 hover:text-slate-200";
            } else {
                if (regFields) regFields.classList.add('hidden');
                if (submitLbl) submitLbl.innerText = 'Sign In';
                if (tabLogin) tabLogin.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-brand-600 text-white";
                if (tabRegister) tabRegister.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all text-slate-400 hover:text-slate-200";
