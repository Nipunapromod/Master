            async function stabilityRequestNotificationPermission() {
                if (!stabilityHasNotificationAPI) return 'unsupported';
                try {
                    if (Notification.permission === 'granted') return 'granted';
                    if (Notification.permission === 'denied') return 'denied';
                    return await Notification.requestPermission();
                } catch (err) {
                    console.warn('Notification permission request failed safely.', err);
                    return 'denied';
                }
            }

            function stabilityClassOccurrenceKey(cls, date) {
                return `${cls.id}|${date}|${cls.time}`;
            }

            function stabilityGetNextClassOccurrence(cls, fromDate = new Date()) {
                const parsed = stabilityParseClassTime(cls.time);
                const dayIndex = STABILITY_DAY_NAMES.indexOf(cls.day);
                if (!parsed || dayIndex < 0) return null;

                const now = new Date(fromDate);
                const currentDay = now.getDay();
                let delta = (dayIndex - currentDay + 7) % 7;
                const startHour = Math.floor(parsed.startMinutes / 60);
                const startMinute = parsed.startMinutes % 60;

                const candidate = new Date(now);
                candidate.setHours(0, 0, 0, 0);
                candidate.setDate(candidate.getDate() + delta);
                candidate.setHours(startHour, startMinute, 0, 0);

                if (candidate.getTime() <= now.getTime()) {
                    candidate.setDate(candidate.getDate() + 7);
                }
                return candidate;
            }

            function stabilityIsNotificationAlreadySent(key) {
                return Array.isArray(stabilityCache.notificationLedger) && stabilityCache.notificationLedger.includes(key);
            }

            function stabilityMarkNotificationSent(key) {
                const ledger = Array.isArray(stabilityCache.notificationLedger) ? stabilityCache.notificationLedger : [];
                if (!ledger.includes(key)) ledger.push(key);
                stabilityCache.notificationLedger = ledger.slice(-STABILITY_NOTIFICATION_LEDGER_LIMIT);
                stabilityScheduleCacheWrite();
            }

            function stabilitySendClassNotification(cls, occurrenceDate) {
                if (!stabilityHasNotificationAPI || Notification.permission !== 'granted') return false;
                const dateKey = occurrenceDate.toISOString().slice(0, 10);
                const key = stabilityClassOccurrenceKey(cls, dateKey);
                if (stabilityIsNotificationAlreadySent(key)) return false;
                try {
                    const notification = new Notification(`Class Reminder: ${cls.name}`, {
                        body: `${cls.day} • ${cls.time}`,
                        tag: `almastermind-class-${cls.id}`,
                        renotify: false,
                        silent: false
                    });
                    notification.onclick = () => {
                        try { window.focus(); } catch (_) {}
                        notification.close();
                    };
                    stabilityMarkNotificationSent(key);
                    return true;
                } catch (err) {
                    console.warn('Notification could not be displayed.', err);
                    return false;
                }
            }

            function stabilityScheduleNotifications() {
                if (stabilityNotificationTimer) {
                    clearTimeout(stabilityNotificationTimer);
                    stabilityNotificationTimer = null;
                }
                if (!stabilityHasNotificationAPI || Notification.permission !== 'granted' || !classLogs.length) return;

                let next = null;
                let nextClass = null;
                for (const cls of classLogs) {
                    const occurrence = stabilityGetNextClassOccurrence(cls);
                    if (!occurrence) continue;
                    if (!next || occurrence.getTime() < next.getTime()) {
                        next = occurrence;
                        nextClass = cls;
                    }
                }

                if (!next || !nextClass) return;

                const delay = Math.max(1000, next.getTime() - Date.now());
                stabilityNotificationTimer = setTimeout(() => {
                    stabilityNotificationTimer = null;
                    try {
                        stabilitySendClassNotification(nextClass, next);
                    } catch (err) {
                        console.warn('Class reminder timer failed safely.', err);
                    } finally {
                        stabilityScheduleNotifications();
                    }
                }, Math.min(delay, 2147483647));
            }

            async function stabilityAddClass(event) {
                event?.preventDefault?.();
                if (stabilityClassSaveInProgress) return;

                const nameEl = stabilityFormControl('class-name');
                const dayEl = stabilityFormControl('class-day');
                const startHourEl = stabilityFormControl('class-start-hour');
                const startMinuteEl = stabilityFormControl('class-start-minute');
                const startAmEl = stabilityFormControl('class-start-ampm');
                const endHourEl = stabilityFormControl('class-end-hour');
                const endMinuteEl = stabilityFormControl('class-end-minute');
                const endAmEl = stabilityFormControl('class-end-ampm');
                if (!nameEl || !dayEl || !startHourEl || !startMinuteEl || !startAmEl || !endHourEl || !endMinuteEl || !endAmEl) {
                    stabilityNotify('Class Reminder Error', 'The class reminder form could not be loaded correctly. Please refresh the page.');
                    return;
                }

                const name = stabilityNormalizeText(nameEl.value);
                const day = stabilitySafeString(dayEl.value).trim();
                const startMinutes = stabilityParseTimePart(startHourEl.value, startMinuteEl.value, startAmEl.value);
                const endMinutes = stabilityParseTimePart(endHourEl.value, endMinuteEl.value, endAmEl.value);
                const time = stabilityFormatDetailedTimeRange(startHourEl.value, startMinuteEl.value, startAmEl.value, endHourEl.value, endMinuteEl.value, endAmEl.value);

                if (!name) {
                    stabilityNotify('Invalid Class Name', 'Class name cannot be empty or only whitespace.');
                    nameEl.focus();
                    return;
                }
                if (!STABILITY_DAY_NAMES.includes(day)) {
                    stabilityNotify('Invalid Day', 'Please select a valid weekday.');
                    return;
                }
                if (startMinutes === null || endMinutes === null || startMinutes === endMinutes) {
                    stabilityNotify('Invalid Schedule', 'Please choose valid start and end times. Start and end cannot be identical.');
                    return;
                }

                const candidate = { id: stabilityEditingClassId || stabilityUuid('class'), name, day, time };
                if (stabilityClassDuplicateExists(candidate, stabilityEditingClassId)) {
                    stabilityNotify('Duplicate Reminder', 'That class reminder already exists with the same name, day, and time.');
                    return;
                }
                if (stabilityClassHasConflict(candidate, stabilityEditingClassId)) {
                    stabilityNotify('Overlapping Schedule', 'This class overlaps another scheduled class, including a cross-midnight schedule.');
                    return;
                }

                stabilityClassSaveInProgress = true;
                const editingId = stabilityEditingClassId;
                stabilitySetFormBusy('class-form', 'class-submit-button', true, editingId ? 'Saving…' : 'Adding…', editingId ? 'Update Reminder' : 'Add Class Reminder');

                try {
                    if (editingId) {
                        stabilityApplyLocalClass(candidate);
                        stabilityEnqueueMutation('class', 'update', editingId, { name, day, time });
                        try {
                            const cloud = await stabilityCloudMutation('class', 'update', editingId, { name, day, time });
                            if (cloud?.id) stabilityApplyLocalClass({ ...candidate, ...cloud, id: cloud.id });
                            stabilityCache.pendingOps = stabilityCache.pendingOps.filter(op => !(op.entity === 'class' && op.id === editingId && op.action === 'update'));
                        } catch (err) {
                            if (!stabilityIsRetryableError(err)) {
                                stabilityCache.pendingOps = stabilityCache.pendingOps.filter(op => !(op.entity === 'class' && op.id === editingId && op.action === 'update'));
                            }
                        }
                    } else {
                        stabilityApplyLocalClass(candidate);
                        try {
                            const cloud = await stabilityCloudMutation('class', 'insert', candidate.id, { name, day, time });
                            if (cloud?.id && cloud.id !== candidate.id) {
                                classLogs = classLogs.map(item => item.id === candidate.id ? stabilityNormalizeClass({ ...candidate, ...cloud, id: cloud.id }) : item);
                                stabilityCache.pendingOps = stabilityCache.pendingOps.filter(op => !(op.entity === 'class' && op.id === candidate.id && op.action === 'insert'));
                            }
                        } catch (err) {
                            stabilityEnqueueMutation('class', 'insert', candidate.id, candidate);
                        }
                    }

                    stabilityCache.classes = [...classLogs];
                    stabilityScheduleCacheWrite();
                    stabilityRenderClasses({ force: true });
                    stabilityScheduleNotifications();
                    if (typeof updateCoreStats === 'function') updateCoreStats();
                    stabilityCancelClassEdit();
                    const permission = await stabilityRequestNotificationPermission();
                    if (permission === 'denied') {
                        stabilityNotify('Reminder Saved', 'The class reminder was saved, but browser notifications are blocked. The dashboard will continue working normally.');
                    } else if (permission === 'unsupported') {
                        stabilityNotify('Reminder Saved', 'The class reminder was saved. This browser does not support system notifications.');
                    } else {
                        stabilityScheduleNotifications();
                        stabilityNotify('Success', 'Class reminder successfully saved and notification scheduling is active.');
                    }
                } catch (err) {
                    console.error('Class reminder save failed safely.', err);
                    stabilityNotify('Reminder Save Error', 'The class reminder could not be saved. Existing schedules were left untouched.');
                } finally {
                    stabilityClassSaveInProgress = false;
                    stabilitySetFormBusy('class-form', 'class-submit-button', false, '', stabilityEditingClassId ? 'Update Reminder' : 'Add Class Reminder');
                    const button = document.getElementById('class-submit-button');
                    if (button) button.textContent = stabilityEditingClassId ? 'Update Reminder' : 'Add Class Reminder';
                    const cancel = document.getElementById('class-cancel-edit');
                    if (!stabilityEditingClassId && cancel) cancel.classList.add('hidden');
                    stabilityFlushPendingMutations().catch(err => console.warn('Class retry sync failed.', err));
                }
            }

