            function stabilityFormatDetailedTimeRange(startH, startM, startAM, endH, endM, endAM) {
                return `${String(startH).padStart(2, '0')}:${String(startM).padStart(2, '0')} ${stabilitySafeString(startAM).toUpperCase()} - ${String(endH).padStart(2, '0')}:${String(endM).padStart(2, '0')} ${stabilitySafeString(endAM).toUpperCase()}`;
            }

            function stabilityParseTaskTime(timeText) {
                const text = stabilitySafeString(timeText).trim();
                const match = text.match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)\s*-\s*(\d{1,2})(?::(\d{2}))?\s*(AM|PM)$/i);
                if (!match) return null;
                const start = stabilityParseTimePart(match[1], match[2] ?? '00', match[3]);
                const end = stabilityParseTimePart(match[4], match[5] ?? '00', match[6]);
                if (start === null || end === null || start === end) return null;
                return { startMinutes: start, endMinutes: end, crossesMidnight: end < start };
            }

            function stabilityParseClassTime(timeText) {
                const parsed = stabilityParseTaskTime(timeText);
