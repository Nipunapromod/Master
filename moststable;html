                    if (supabaseClient && stabilityGetUserId()) {
                        try {
                            await stabilityWithRetry(() => supabaseClient.from('profiles').upsert({
                                id: stabilityGetUserId(),
                                name: studentProfile.name,
                                year: studentProfile.year,
                                course: studentProfile.course,
                                district: studentProfile.district,
                                gemini_api_key: studentProfile.gemini_api_key || ''
                            }), 3);
                        } catch (err) {
                            stabilityNotify('Saved Locally', 'Profile changes were saved in this browser, but cloud sync will retry later.');
                        }
                    }
                    if (typeof syncProfileUI === 'function') syncProfileUI();
                    if (typeof updateCoreStats === 'function') updateCoreStats();
                    stabilityNotify('Profile Updated', 'Your profile changes were saved successfully.');
                } catch (err) {
                    console.error('Profile save failed safely.', err);
                    stabilityNotify('Profile Error', 'The profile could not be updated safely.');
                }
            }

            async function stabilitySaveGeminiApiKey() {
                try {
                    const input = document.getElementById('gemini-api-key-input');
                    const inputVal = stabilitySafeString(input?.value).trim();
                    if (!inputVal) {
                        stabilityNotify('Error', 'Please enter a valid API key.');
                        return;
                    }
                    studentProfile.gemini_api_key = inputVal;
                    try { localStorage.setItem('gemini_api_key', inputVal); } catch (_) {}
                    if (supabaseClient && stabilityGetUserId()) {
                        try {
                            await stabilityWithRetry(() => supabaseClient.from('profiles').upsert({ id: stabilityGetUserId(), gemini_api_key: inputVal }), 3);
                        } catch (err) {
                            stabilityNotify('Saved Locally', 'The API key was saved locally, but cloud sync will retry later.');
                        }
                    }
                    stabilityNotify('Key Saved', 'Your Gemini API key has been saved for this dashboard.');
                    if (typeof checkGeminiKeyAndProceed === 'function') checkGeminiKeyAndProceed();
                } catch (err) {
                    console.error('Gemini key save failed safely.', err);
                    stabilityNotify('Save Error', 'The API key could not be saved safely.');
                }
            }

            function stabilityInstallEventHandlers() {
                if (stabilityInitialized) return;
                stabilityInitialized = true;

                stabilityDetectStorage();
                stabilityLoadCache();

                const taskContainer = document.getElementById('task-list-container');
                const classContainer = document.getElementById('classes-list-container');
                if (taskContainer) {
                    taskContainer.addEventListener('click', stabilityHandleTaskContainerClick, { passive: true });
                    taskContainer.addEventListener('click', stabilityHandleLoadMore, { passive: true });
                    taskContainer.addEventListener('scroll', stabilityMaybeLoadMoreOnScroll, { passive: true });
                }
                if (classContainer) {
                    classContainer.addEventListener('click', stabilityHandleClassContainerClick, { passive: true });
                    classContainer.addEventListener('click', stabilityHandleLoadMore, { passive: true });
                    classContainer.addEventListener('scroll', stabilityMaybeLoadMoreOnScroll, { passive: true });
                }

                window.addEventListener('online', () => {
                    stabilityFlushPendingMutations().catch(err => console.warn('Online sync failed safely.', err));
                    stabilityScheduleNotifications();
                }, { passive: true });

                window.addEventListener('offline', () => {
                    const taskBox = document.getElementById('task-list-container');
                    const classBox = document.getElementById('classes-list-container');
                    stabilityInlineStatus(taskBox, 'Offline mode enabled. New changes will be saved locally and synced when the connection returns.');
                    stabilityInlineStatus(classBox, 'Offline mode enabled. New changes will be saved locally and synced when the connection returns.');
                }, { passive: true });

                window.addEventListener('resize', () => {
                    if (stabilityResizeFrame) cancelAnimationFrame(stabilityResizeFrame);
                    stabilityResizeFrame = requestAnimationFrame(() => {
                        stabilityResizeFrame = null;
                        try { performanceChartInstance?.resize?.(); } catch (err) { console.warn('Main chart resize skipped.', err); }
                        try { chatSideChartInstance?.resize?.(); } catch (err) { console.warn('Chat chart resize skipped.', err); }
                    });
                }, { passive: true });

                if (window.visualViewport) {
                    window.visualViewport.addEventListener('resize', () => {
                        if (stabilityResizeFrame) cancelAnimationFrame(stabilityResizeFrame);
                        stabilityResizeFrame = requestAnimationFrame(() => {
                            stabilityResizeFrame = null;
                            document.documentElement.style.setProperty('--app-viewport-height', `${window.visualViewport.height}px`);
                            try { performanceChartInstance?.resize?.(); } catch (_) {}
                            try { chatSideChartInstance?.resize?.(); } catch (_) {}
                        });
                    }, { passive: true });
                }

                window.addEventListener('pagehide', () => {
                    try { stabilityWriteCacheNow(); } catch (_) {}
                    if (stabilityNotificationTimer) clearTimeout(stabilityNotificationTimer);
                    if (stabilityPendingRetryTimer) clearTimeout(stabilityPendingRetryTimer);
                });

                window.addEventListener('beforeunload', () => {
                    try { stabilityWriteCacheNow(); } catch (_) {}
                });

                window.addEventListener('error', event => {
                    console.error('Dashboard runtime error captured safely:', event.error || event.message);
                    event.preventDefault();
                });

                window.addEventListener('unhandledrejection', event => {
                    console.error('Dashboard async error captured safely:', event.reason);
                    event.preventDefault();
                });
            }

            // Replace only the public handlers that need hardening. The rest of
            // the existing dashboard remains intact and keeps the same UI.
            window.addTask = stabilityAddTask;
            window.toggleTask = stabilityToggleTask;
            window.deleteTask = stabilityDeleteTask;
            window.addClass = stabilityAddClass;
            window.deleteClass = stabilityDeleteClass;
            window.renderTasks = stabilityRenderTasks;
            window.renderClasses = stabilityRenderClasses;
            window.loadCloudData = stabilityLoadCloudData;
            window.checkSessionStatus = stabilityCheckSessionStatus;
            window.setChartFilter = stabilityDebouncedSetChartFilter;
            window.renderMarksAnalytics = stabilityRenderMarksAnalytics;
            window.saveProfile = stabilitySaveProfile;
            window.saveGeminiApiKey = stabilitySaveGeminiApiKey;
            window.cancelTaskEdit = stabilityCancelTaskEdit;
            window.cancelClassEdit = stabilityCancelClassEdit;

            // Ensure the original window.onload handler uses the hardened functions.
            // It still runs normally, but we initialize delegated listeners exactly once.
            setInterval(() => {
                validateSevenDaySession();
                updateSessionExpiryUI();
            }, 60 * 1000);

            window.addEventListener('load', () => {
                try {
                    stabilityInstallEventHandlers();
                    stabilityLoadCache();
                    taskLogs = stabilityDedupeById(taskLogs, stabilityNormalizeTask);
                    classLogs = stabilityDedupeById(classLogs, stabilityNormalizeClass);
                    stabilityRenderTasks({ force: true });
                    stabilityRenderClasses({ force: true });
                    stabilityScheduleNotifications();
                    stabilityFlushPendingMutations().catch(err => console.warn('Initial pending sync failed safely.', err));
                } catch (err) {
                    console.error('Stability layer initialization failed safely.', err);
                    stabilityNotify('Dashboard Recovery', 'The dashboard loaded with a safe fallback mode. Refreshing is not required unless a feature remains unavailable.');
                }
            }, { once: true });
        })();
    </script>


    <!-- ===== A/L MASTERMIND v7 UX UPGRADE ===== -->
    <div id="app-toast-stack" class="fixed top-4 right-4 z-[100] w-[min(92vw,380px)] space-y-2 pointer-events-none" aria-live="polite"></div>

    <div id="offline-banner" class="hidden fixed top-0 left-0 right-0 z-[95] bg-amber-500 text-slate-950 text-center text-xs font-extrabold px-4 py-2 shadow-lg">
        <i class="fa-solid fa-cloud-arrow-down mr-1"></i>
        Offline mode: changes are saved locally and will sync when you reconnect.
    </div>

    <div id="command-palette" class="hidden fixed inset-0 z-[90] bg-slate-950/75 backdrop-blur-sm p-4 md:p-8">
        <div id="command-palette-panel" class="mx-auto mt-[8vh] w-full max-w-2xl overflow-hidden rounded-3xl border border-slate-700 bg-slate-900 shadow-2xl shadow-black/50">
            <div class="flex items-center gap-3 border-b border-slate-800 px-4">
                <i class="fa-solid fa-magnifying-glass text-slate-500"></i>
                <input id="command-palette-input" type="search" autocomplete="off"
                       placeholder="Search dashboard or jump to a section…"
                       class="w-full bg-transparent py-4 text-sm text-white outline-none placeholder:text-slate-500">
                <kbd class="hidden sm:inline-flex rounded-md border border-slate-700 bg-slate-950 px-2 py-1 text-[10px] text-slate-500">ESC</kbd>
            </div>
            <div id="command-palette-results" class="max-h-[55vh] overflow-y-auto p-2"></div>
