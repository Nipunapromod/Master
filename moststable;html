        const isGapSegment = (ctx) => {
            if (!ctx.p0 || !ctx.p1 || ctx.p0.skip || ctx.p1.skip) return false;
            const idx0 = ctx.p0DataIndex;
            const idx1 = ctx.p1DataIndex;
            if (idx1 - idx0 > 1) return true;
            
            const dataset = ctx.dataset;
            if (dataset && dataset.data) {
                for (let i = idx0 + 1; i < idx1; i++) {
                    if (dataset.data[i] === null) {
                        return true;
                    }
                }
            }
            return false;
        };

        const gapSegmentDash = (ctx) => {
