    </div>

    <button id="back-to-top" type="button"
            class="hidden fixed bottom-20 right-4 md:bottom-6 md:right-6 z-30 w-11 h-11 rounded-full bg-brand-600 hover:bg-brand-500 text-white shadow-xl shadow-brand-950/40 transition"
            aria-label="Back to top" title="Back to top">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <style>
        /* v7 polish: visual hierarchy, safe-area support, and interaction quality */
        :root { --app-viewport-height: 100dvh; }
        * { scrollbar-width: thin; scrollbar-color: #334155 transparent; }
        body { min-height: var(--app-viewport-height); }
        #mobile-bottom-nav { padding-left: max(.5rem, env(safe-area-inset-left)); padding-right: max(.5rem, env(safe-area-inset-right)); }
        #mobile-bottom-nav .mobile-tab-btn { min-height: 48px; border-radius: .9rem; transition: transform .16s ease, background .16s ease; }
        #mobile-bottom-nav .mobile-tab-btn:active { transform: scale(.96); }
        #mobile-bottom-nav .mobile-tab-btn.text-brand-400 { background: rgba(139,92,246,.10); }
        .v7-command-item { display:flex; align-items:center; gap:.75rem; width:100%; text-align:left; padding:.75rem .8rem; border-radius:.8rem; color:#cbd5e1; }
        .v7-command-item:hover, .v7-command-item.active { background:#1e293b; color:#fff; }
        .v7-command-icon { width:2rem; height:2rem; border-radius:.65rem; display:grid; place-items:center; background:rgba(139,92,246,.10); color:#a78bfa; flex:none; }
        .v7-toast { pointer-events:auto; border:1px solid rgba(71,85,105,.8); background:rgba(15,23,42,.96); backdrop-filter:blur(14px); border-radius:1rem; padding:.8rem .9rem; box-shadow:0 16px 40px rgba(0,0,0,.35); animation:v7ToastIn .22s ease-out; }
        @keyframes v7ToastIn { from { opacity:0; transform:translateY(-8px) scale(.98); } to { opacity:1; transform:none; } }
        @media (max-width: 767px) {
            #network-status-badge { display:none !important; }
            #app-toast-stack { top: max(.75rem, env(safe-area-inset-top)); right:.75rem; }
            #command-palette-panel { margin-top:4vh; }
        }
        @media (prefers-reduced-motion: reduce) {
            .v7-toast { animation:none; }
        }
    </style>

    <script>
    (() => {
        'use strict';

        const V7 = {
            activeCommand: 0,
            commands: [
                { id:'home', label:'Overview & Clock', hint:'Dashboard overview', icon:'fa-house', action:() => switchTab('home') },
                { id:'tracker', label:'Marks Tracker', hint:'Scores and progression', icon:'fa-chart-line', action:() => switchTab('tracker') },
                { id:'tasks', label:'Tasks & Classes', hint:'To-do list and reminders', icon:'fa-list-check', action:() => switchTab('tasks') },
                { id:'forgetting', label:'Recall Planner', hint:'Active recall schedule', icon:'fa-brain', action:() => switchTab('forgetting') },
                { id:'ai', label:'Mastermind AI Coach', hint:'AI study assistant', icon:'fa-wand-magic-sparkles', action:() => switchTab('ai') },
                { id:'settings', label:'Settings', hint:'Profile and configuration', icon:'fa-sliders', action:() => switchTab('settings') },
                { id:'new-task', label:'Add a Task', hint:'Open task manager', icon:'fa-plus', action:() => { switchTab('tasks'); setTimeout(() => document.getElementById('task-name')?.focus(), 120); } },
                { id:'new-paper', label:'Log a Practice Paper', hint:'Record marks', icon:'fa-file-pen', action:() => { switchTab('tracker'); setTimeout(() => openLogPaperModal(), 120); } },
            ]
        };

        const $ = id => document.getElementById(id);

        function toast(message, type='info') {
            const stack = $('app-toast-stack');
            if (!stack) return;
            const el = document.createElement('div');
            const icon = type === 'success' ? 'fa-circle-check text-emerald-400' :
                         type === 'error' ? 'fa-circle-exclamation text-rose-400' :
                         type === 'warning' ? 'fa-triangle-exclamation text-amber-400' :
                         'fa-circle-info text-indigo-400';
            el.className = 'v7-toast text-xs text-slate-200 flex items-start gap-2';
            el.innerHTML = `<i class="fa-solid ${icon} mt-0.5"></i><span></span>`;
            el.querySelector('span').textContent = message;
            stack.appendChild(el);
            setTimeout(() => {
                el.style.opacity = '0';
                el.style.transform = 'translateY(-5px)';
                el.style.transition = 'opacity .18s, transform .18s';
                setTimeout(() => el.remove(), 220);
            }, 3200);
        }

        window.v7Toast = toast;

        function updateNetworkStatus() {
            const online = navigator.onLine;
            const badge = $('network-status-badge');
            const dot = $('network-status-dot');
            const label = $('network-status-text');
            const banner = $('offline-banner');
            if (badge && dot && label) {
                label.textContent = online ? 'Online' : 'Offline';
                dot.className = `w-1.5 h-1.5 rounded-full ${online ? 'bg-emerald-400' : 'bg-amber-400'}`;
                badge.className = `hidden sm:inline-flex ${online ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-300' : 'bg-amber-500/10 border-amber-500/20 text-amber-300'} border px-2.5 py-1.5 rounded-lg text-[10px] font-semibold items-center gap-1.5`;
            }
            banner?.classList.toggle('hidden', online);
        }

        window.addEventListener('online', () => { updateNetworkStatus(); toast('Connection restored. Pending changes can sync now.', 'success'); });
        window.addEventListener('offline', () => { updateNetworkStatus(); toast('You are offline. Local saving remains available.', 'warning'); });
        window.addEventListener('load', updateNetworkStatus);

        function renderCommands(query='') {
            const box = $('command-palette-results');
            if (!box) return;
            const q = query.trim().toLowerCase();
            const matches = V7.commands.filter(c => !q || `${c.label} ${c.hint}`.toLowerCase().includes(q));
            V7.activeCommand = Math.min(V7.activeCommand, Math.max(0, matches.length - 1));
            box.innerHTML = '';
            if (!matches.length) {
                box.innerHTML = '<p class="p-6 text-center text-xs text-slate-500">No dashboard action matches that search.</p>';
                return;
            }
            matches.forEach((cmd, index) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = `v7-command-item ${index === V7.activeCommand ? 'active' : ''}`;
                button.dataset.commandId = cmd.id;
                button.innerHTML = `<span class="v7-command-icon"><i class="fa-solid ${cmd.icon}"></i></span>
                    <span class="min-w-0"><strong class="block text-xs">${cmd.label}</strong><small class="block truncate text-[10px] text-slate-500">${cmd.hint}</small></span>`;
                button.addEventListener('click', () => { cmd.action(); closePalette(); });
                box.appendChild(button);
            });
        }

        function openPalette() {
            const modal = $('command-palette');
            if (!modal) return;
            modal.classList.remove('hidden');
            V7.activeCommand = 0;
            renderCommands($('command-palette-input')?.value || '');
            setTimeout(() => $('command-palette-input')?.focus(), 20);
        }

        function closePalette() {
            $('command-palette')?.classList.add('hidden');
        }

        $('command-palette-input')?.addEventListener('input', e => {
            V7.activeCommand = 0;
            renderCommands(e.target.value);
        });

        $('command-palette')?.addEventListener('click', e => {
            if (e.target === $('command-palette')) closePalette();
        });

        document.addEventListener('keydown', e => {
            const modifier = e.ctrlKey || e.metaKey;
            if (modifier && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                openPalette();
                return;
            }
            if ($('command-palette') && !$('command-palette').classList.contains('hidden')) {
                const items = [...document.querySelectorAll('.v7-command-item')];
                if (e.key === 'Escape') { closePalette(); return; }
                if (e.key === 'ArrowDown' && items.length) {
                    e.preventDefault();
                    V7.activeCommand = (V7.activeCommand + 1) % items.length;
                    renderCommands($('command-palette-input')?.value || '');
                } else if (e.key === 'ArrowUp' && items.length) {
                    e.preventDefault();
                    V7.activeCommand = (V7.activeCommand - 1 + items.length) % items.length;
                    renderCommands($('command-palette-input')?.value || '');
                } else if (e.key === 'Enter' && items[V7.activeCommand]) {
                    e.preventDefault();
                    items[V7.activeCommand].click();
                }
            }
        });

        // Back-to-top button improves long-page navigation on phones and desktops.
        const backTop = $('back-to-top');
        const main = document.querySelector('main');
        main?.addEventListener('scroll', () => {
            backTop?.classList.toggle('hidden', main.scrollTop < 420);
        }, { passive:true });
        backTop?.addEventListener('click', () => main?.scrollTo({top:0, behavior:'smooth'}));

        // Installable PWA prompt. The browser decides whether installation is available.
        let deferredInstallPrompt = null;
        window.addEventListener('beforeinstallprompt', e => {
            e.preventDefault();
            deferredInstallPrompt = e;
            const btn = $('install-app-button');
            if (btn) btn.classList.remove('hidden');
        });
        $('install-app-button')?.addEventListener('click', async () => {
            if (!deferredInstallPrompt) {
                toast('Install is not available in this browser/session.', 'info');
                return;
            }
            deferredInstallPrompt.prompt();
            try { await deferredInstallPrompt.userChoice; } catch (_) {}
            deferredInstallPrompt = null;
            $('install-app-button')?.classList.add('hidden');
        });
        window.addEventListener('appinstalled', () => {
            deferredInstallPrompt = null;
            $('install-app-button')?.classList.add('hidden');
            toast('A/L Mastermind was installed successfully.', 'success');
        });

        // Restore the last open dashboard section between visits.
        const originalSwitchTab = window.switchTab;
        if (typeof originalSwitchTab === 'function') {
            window.switchTab = function(tabId) {
                try { sessionStorage.setItem('almastermind:last-tab', tabId); } catch (_) {}
                return originalSwitchTab(tabId);
            };
        }
        window.addEventListener('load', () => {
            try {
                const last = sessionStorage.getItem('almastermind:last-tab');
                if (last && document.getElementById(`tab-content-${last}`)) setTimeout(() => window.switchTab(last), 80);
            } catch (_) {}
        });

        // Auto-save unfinished task/class form drafts locally. Nothing is sent to the cloud.
        const draftFields = [
            ['task-form','task-name'], ['task-form','task-date'],
            ['class-form','class-name']
        ];
        draftFields.forEach(([formId, fieldId]) => {
            const field = $(fieldId);
            if (!field) return;
            const key = `almastermind:draft:${fieldId}`;
            try {
                const saved = localStorage.getItem(key);
                if (saved && !field.value) field.value = saved;
            } catch (_) {}
            field.addEventListener('input', () => {
                try { localStorage.setItem(key, field.value); } catch (_) {}
            });
            field.addEventListener('change', () => {
                if (field.value) try { localStorage.removeItem(key); } catch (_) {}
            });
        });

        ['task-form','class-form'].forEach(formId => {
            $(formId)?.addEventListener('submit', () => {
                const form = $(formId);
                form?.querySelectorAll('input').forEach(input => {
                    try { localStorage.removeItem(`almastermind:draft:${input.id}`); } catch (_) {}
                });
            });
        });

        // Expose a lightweight manual toast for existing dashboard code.
        window.showV7Toast = toast;
    })();
    </script>

