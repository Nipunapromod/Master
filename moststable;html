        function detectQuestionSubject(text) {
            const query = String(text || '').toLowerCase();

            const subjectRules = {
                'Combined Mathematics': [
                    /\bmaths?\b/, /\bmathematics\b/, /\balgebra\b/, /\bcalculus\b/,
                    /\bderivative\b/, /\bdifferentiat/, /\bintegrat/, /\blimit\b/,
                    /\btrigonometry\b/, /\bsin\b/, /\bcos\b/, /\btan\b/,
                    /\bvector\b/, /\bmatrix\b/, /\bcomplex number/, /\blogarithm/,
                    /ගණිත/, /අවකල/, /අනුකල/, /සීමා/, /ත්‍රිකෝණමිත/
                ],
                'Physics': [
                    /\bphysics\b/, /\bmechanics\b/, /\bforce\b/, /\bvelocity\b/,
                    /\bacceleration\b/, /\bmomentum\b/, /\bprojectile\b/,
                    /\belectric/, /\bvoltage\b/, /\bcurrent\b/, /\bcircuit\b/,
                    /\bwave\b/, /\boptics\b/, /\bmagnetic/, /භෞතික/, /බලය/,
                    /වේගය/, /ත්වරණ/, /විදුලි/, /ධාරාව/
                ],
                'Chemistry': [
                    /\bchemistry\b/, /\batom\b/, /\bmolecule\b/, /\bmole\b/,
                    /\bmolar\b/, /\breaction\b/, /\bacid\b/, /\bbase\b/,
                    /\borganic\b/, /\binorganic\b/, /\bequilibrium\b/,
                    /\benthalpy\b/, /\boxidation\b/, /\breduction\b/, /\bbond\b/,
                    /රසායන/, /පරමාණු/, /අණු/, /මවුල/, /අම්ල/, /භස්ම/, /කාබනික/, /අකාබනික/
                ]
            };

            let bestSubject = '';
            let bestScore = 0;

            Object.entries(subjectRules).forEach(([subject, rules]) => {
                const score = rules.reduce((total, rule) => total + (rule.test(query) ? 1 : 0), 0);
                if (score > bestScore) {
                    bestSubject = subject;
                    bestScore = score;
                }
            });

            if (bestScore > 0) return bestSubject;
            return activeChartFilter !== 'All' ? activeChartFilter : 'General';
        }

        function isStudentDataRequest(text) {
            const query = String(text || '').toLowerCase();
            return /marks?|scores?|grade|performance|progress|trend|paper|z[- ]?score|cut[- ]?off|admission|district|task|schedule|study plan|revision plan|recall|weakness|strength|ලකුණු|ප්‍රගතිය|කාලසටහන|අධ්‍යයන සැලැස්ම/.test(query);
        }

        async function makeAICall(promptContent) {
            const maxRetries = 2;
            const detectedSubject = detectQuestionSubject(promptContent);
            const includeStudentData = isStudentDataRequest(promptContent);

            const subjectSpecificFocus = detectedSubject === 'General'
                ? 'Answer only the current user question. Do not introduce Combined Mathematics, Physics, or Chemistry unless the question requires it.'
                : `The current question is mainly about ${detectedSubject}. Stay inside this subject. Do not discuss the other A/L subjects unless the user explicitly asks for a comparison or connection.`;

            const languageConstraint = selectedMedium === 'Sinhala'
                ? `Answer entirely in clear Sinhala. Keep standard scientific symbols, formulas, units, and accepted English technical terms when they improve accuracy.`
                : `Answer in clear, simple English using accurate Sri Lankan A/L terminology.`;

            const studentContext = includeStudentData
                ? `Student profile:
- Student Name: ${studentProfile.name || 'Student'}
- Target Exam Date: ${studentProfile.year || 'Not configured'}
- Target Course: ${studentProfile.course || 'Not configured'}
- Cutoff District: ${studentProfile.district || 'Not configured'}

Logged paper scores:
${JSON.stringify(paperLogs)}

Tasks and homework:
${JSON.stringify(taskLogs)}

Active-recall logs:
${JSON.stringify(recallLogs)}`
                : `Student records are intentionally omitted because this is a direct question. Do not invent or discuss marks, schedules, Z-scores, study plans, or performance data.`;

            const responseMode = includeStudentData
                ? `This is a student-data or planning request. Use only the relevant supplied records and give a focused, practical analysis.`
                : `This is a direct question. Start with the answer immediately. Do not add greetings, motivation, study plans, exam tips, unrelated definitions, or extra subject content.`;

            const systemPrompt = `You are Mastermind AI, a warm, friendly, patient Sri Lankan Advanced Level study companion and tutor.

Personality: supportive, natural, encouraging, and calm. Sound like a helpful senior tutor who genuinely wants the student to understand, not like a robotic examiner. Use small touches of friendly language and occasional emojis when appropriate, but never overdo them. Celebrate correct thinking briefly, normalize mistakes, and explain confusing parts without making the student feel bad. Never be sarcastic, judgmental, or overly formal.

Teaching style: start with the useful answer, then explain the reasoning in simple steps. If the student seems confused, slow down and give a simpler explanation or a tiny example. For calculations, show the formula, substitution, and final answer clearly. For difficult A/L concepts, connect the idea to an intuitive example when useful. Stay aligned with the Sri Lankan A/L level and terminology.

Current subject rule:

Current subject rule:
${subjectSpecificFocus}

Language rule:
${languageConstraint}

Response mode:
${responseMode}

Available context:
${studentContext}

Strict answer rules:
1. Answer exactly what the latest user message asks. The latest message has higher priority than older chat history.
2. Never mix subjects unnecessarily. Keep Maths, Chemistry, and Physics answers focused.
3. Be friendly and human-sounding, but keep the academic content accurate.
4. For a simple fact, use 1-3 short sentences. For a calculation, show formula, substitution, and final answer. For an explanation, normally use short bullets.
5. If the student makes a mistake, correct it gently and explain why. Never shame the student.
6. Use examples, common mistakes, exam tips, or background theory when requested or when they clearly help understanding.
7. Use standard LaTeX: inline math inside $...$ and block math inside $$...$$.
8. State uncertainty briefly instead of guessing. Ask one clarification only when the problem cannot be solved without missing information.
9. Never claim an exact Z-score, rank, cutoff, or admission result without enough verified data.
10. Keep responses clear, practical, concise, and encouraging. Avoid generic motivational speeches.
11. End naturally when the answer is complete. Do not repeatedly ask whether the student needs more help.`;

            const activeAPIKey =
                studentProfile.gemini_api_key ||
                localStorage.getItem('gemini_api_key') ||
                '';

            const useProxy =
                typeof geminiProxyUrl === 'string' &&
                geminiProxyUrl.trim().length > 0;

            if (!useProxy && !activeAPIKey) {
                throw new Error(
                    'Gemini API key is missing. Add a valid Google AI Studio API key in Settings.'
                );
            }

            const apiUrl = useProxy
                ? geminiProxyUrl.trim()
                : `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(GEMINI_MODEL)}:generateContent`;

            const headers = {
                'Content-Type': 'application/json'
            };

            if (!useProxy) {
                headers['x-goog-api-key'] = activeAPIKey;
            }

            // The current user message has already been added to aiChatHistory.
            // Exclude it here, then append promptContent once to avoid duplication.
            const recentHistory = aiChatHistory
                .slice(0, -1)
                .slice(-8)
                .filter(entry => entry && typeof entry.text === 'string' && entry.text.trim())
                .map(entry => ({
                    role: entry.isAI ? 'model' : 'user',
                    parts: [{ text: entry.text }]
                }));

            // Gemini conversation history should begin with a user turn.
            while (recentHistory.length && recentHistory[0].role === 'model') {
                recentHistory.shift();
            }

            const payload = {
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                },
                contents: [
                    ...recentHistory,
                    {
                        role: 'user',
                        parts: [{ text: promptContent }]
                    }
                ],
                generationConfig: {
                    temperature: 0.45,
                    maxOutputTokens: 8192,
                    candidateCount: 1
                }
            };

            let delay = 1000;

            for (let attempt = 1; attempt <= maxRetries; attempt++) {
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers,
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json().catch(() => ({}));

                    if (!response.ok) {
                        const apiMessage =
                            data?.error?.message ||
                            `Gemini request failed with HTTP ${response.status}.`;

                        const apiError = new Error(apiMessage);
                        apiError.status = response.status;
                        throw apiError;
                    }

                    const blockReason = data?.promptFeedback?.blockReason;
                    const text = data?.candidates?.[0]?.content?.parts
                        ?.map(part => part?.text || '')
                        .join('')
                        .trim();

                    if (text) {
                        return text;
                    }

                    if (blockReason) {
                        throw new Error(`Gemini blocked the request: ${blockReason}.`);
                    }

                    const candidate = data?.candidates?.[0];
                    const finishReason = candidate?.finishReason;
                    const finishMessage = candidate?.finishMessage;
                    if (finishReason && finishReason !== 'STOP') {
                        const friendlyReason = finishReason === 'MAX_TOKENS'
                            ? 'The response was too long. Try asking a shorter question.'
                            : finishReason === 'SAFETY'
                                ? 'Gemini could not provide that response because of its safety filters.'
                                : `Gemini stopped before completing the response (${finishReason}).`;
                        throw new Error(finishMessage ? `${friendlyReason} ${finishMessage}` : friendlyReason);
                    }

                    throw new Error('Gemini returned no readable text. Please try the question again.');
                } catch (err) {
                    const status = Number(err?.status || 0);
                    const retryable =
                        status === 429 ||
                        status >= 500 ||
                        status === 0;

                    console.error(`Gemini request attempt ${attempt} failed:`, err);

                    if (attempt < maxRetries && retryable) {
                        await new Promise(resolve => setTimeout(resolve, delay));
                        delay *= 2;
                        continue;
                    }

                    throw err;
                }
            }

            throw new Error('All Gemini API attempts failed.');
        }

