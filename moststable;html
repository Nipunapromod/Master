            if (dtBtn) {
                dtBtn.classList.add('bg-brand-600', 'text-white');
                dtBtn.classList.remove('text-slate-400', 'hover:bg-slate-800', 'hover:text-slate-200');
            }

            const mobileBtns = document.querySelectorAll('.mobile-tab-btn');
            mobileBtns.forEach(btn => {
                if (btn.innerText.toLowerCase().includes(tabId === 'tracker' ? 'track' : tabId === 'tasks' ? 'task' : tabId === 'forgetting' ? 'recall' : tabId === 'ai' ? 'gemini' : tabId === 'settings' ? 'sett' : 'home')) {
                    btn.classList.add('text-brand-400');
                    btn.classList.remove('text-slate-500');
                }
            });

            if (tabId === 'tracker') {
                renderMarksAnalytics();
            } else if (tabId === 'forgetting') {
                renderRecallPlanner();
            } else if (tabId === 'ai') {
                checkGeminiKeyAndProceed();
                setTimeout(renderChatViewChart, 100);
            }
        }

