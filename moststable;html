        async function advanceRecallStage(id) {
            const item = recallLogs.find(r => r.id === id);
            if (!item) return;

            const nextCount = (item.reviewed_count ?? item.reviewedCount ?? 0) + 1;

            if (supabaseClient) {
                try {
                    const { data: { user } } = await supabaseClient.auth.getUser();
                    const { error } = await supabaseClient.from('recalls').update({ reviewed_count: nextCount }).eq('id', id).eq('user_id', user.id);
                    if (!error) {
                        recallLogs = recallLogs.map(r => r.id === id ? { ...r, reviewed_count: nextCount, reviewedCount: nextCount } : r);
                    }
                } catch (err) {
                    recallLogs = recallLogs.map(r => r.id === id ? { ...r, reviewedCount: nextCount, reviewed_count: nextCount } : r);
                }
            } else {
                recallLogs = recallLogs.map(r => r.id === id ? { ...r, reviewedCount: nextCount, reviewed_count: nextCount } : r);
            }
            renderRecallPlanner();
            updateCoreStats();
        }

