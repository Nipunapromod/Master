        /* ===== Stability / responsive hardening layer ===== */
        html, body {
            width: 100%;
            max-width: 100%;
            min-height: 100%;
            overflow-x: hidden;
        }

        body {
            min-height: 100dvh;
            min-height: -webkit-fill-available;
            overscroll-behavior: none;
        }

        header, main, aside, section, .tab-pane, .grid, .flex, .overflow-x-auto {
            min-width: 0;
        }

        main {
            overscroll-behavior-y: contain;
            scroll-behavior: auto;
            padding-bottom: max(6rem, env(safe-area-inset-bottom));
        }

        header {
            padding-top: max(1rem, env(safe-area-inset-top));
            padding-left: max(1rem, env(safe-area-inset-left));
            padding-right: max(1rem, env(safe-area-inset-right));
        }

        button, input, select, textarea, a {
            -webkit-tap-highlight-color: transparent;
        }

        button, [role="button"], input[type="checkbox"], input[type="radio"] {
            touch-action: manipulation;
        }

        button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, a:focus-visible {
            outline: 2px solid #a78bfa;
            outline-offset: 2px;
        }

        #task-list-container, #classes-list-container {
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
        }

        #marksChart, #chatSideChart {
            display: block;
            max-width: 100%;
        }

        #marksChart {
            min-height: 0;
        }

        .task-time-row, .class-time-row {
            width: 100%;
            max-width: 100%;
            flex-wrap: wrap;
            min-width: 0;
        }

        .task-time-row select, .class-time-row select {
            min-width: 0;
            max-width: 100%;
        }

        @media (max-width: 767px) {
            main {
                padding-left: max(0.75rem, env(safe-area-inset-left));
                padding-right: max(0.75rem, env(safe-area-inset-right));
                padding-bottom: max(6rem, env(safe-area-inset-bottom));
            }

            header {
                gap: 0.75rem;
            }

            header > div:last-child {
                min-width: 0;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 0.35rem;
            }

            header h1 {
                font-size: 0.95rem;
            }

            header p {
                max-width: 42vw;
                line-height: 1.15;
            }

            input, select, textarea {
                font-size: 16px !important;
            }

            button, [role="button"] {
                min-height: 44px;
                min-width: 44px;
            }

            .task-time-row, .class-time-row {
                row-gap: 0.35rem;
                column-gap: 0.25rem;
            }

            .task-time-row select, .class-time-row select {
                flex: 1 1 3.4rem;
            }

            #marksChart {
                min-height: 250px;
            }

            #tab-content-ai {
                height: calc(100dvh - 9rem);
                min-height: 0;
            }
        }

        @media (max-width: 360px) {
            main {
                padding-left: max(0.5rem, env(safe-area-inset-left));
                padding-right: max(0.5rem, env(safe-area-inset-right));
            }

            .rounded-3xl, .rounded-2xl {
                border-radius: 1rem;
            }

            .task-time-row, .class-time-row {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .task-time-row > span, .class-time-row > span {
                display: none;
            }
        }

        @media (orientation: landscape) and (max-height: 520px) {
            main {
                padding-top: 0.75rem;
                padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
            }

            #tab-content-ai {
                height: calc(100dvh - 7rem);
            }
        }

        @media (min-width: 1920px) {
            main {
                padding-left: 4rem;
                padding-right: 4rem;
            }

            aside {
                width: 18rem;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }

