                    studentProfile = {
                        name: profileData.name,
                        year: profileData.year,
                        course: profileData.course,
                        district: profileData.district,
                        gemini_api_key: profileData.gemini_api_key || ""
                    };
                    if (profileData.gemini_api_key) {
                        localStorage.setItem('gemini_api_key', profileData.gemini_api_key);
                    }
                } else {
                    // First-time Google users: take the name directly from Google
                    // and ask for the remaining profile details after login.
                    const googleName =
                        user.user_metadata?.full_name ||
                        user.user_metadata?.name ||
                        user.email?.split('@')[0] ||
                        'Scholar';

                    studentProfile = {
                        name: googleName,
                        year: "2027-08-10",
                        course: "",
                        district: "",
                        gemini_api_key: ""
                    };
