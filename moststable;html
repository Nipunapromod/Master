            function stabilityNormalizeTask(record) {
                if (!record || typeof record !== 'object') return null;
                const name = stabilityNormalizeText(record.name);
                const date = stabilitySafeString(record.date).trim();
                const time = stabilityNormalizeText(record.time);
                if (!name || !stabilityDateIsValid(date) || !stabilityParseTaskTime(time)) return null;
                return {
                    id: stabilityNormalizeId(record.id),
                    user_id: record.user_id || undefined,
                    name,
