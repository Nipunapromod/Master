                if (!name || !STABILITY_DAY_NAMES.includes(day) || !stabilityParseClassTime(time)) return null;
                return {
                    id: stabilityNormalizeId(record.id),
                    user_id: record.user_id || undefined,
                    name,
                    day,
                    time
                };
