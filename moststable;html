            recallLogs.forEach(item => {
                const initialDate = new Date(item.date_studied ?? item.dateStudied);
                const currentReviewedCount = item.reviewed_count ?? item.reviewedCount ?? 0;
                
                let phasesHtml = '';
                for (let i = 0; i < 4; i++) {
