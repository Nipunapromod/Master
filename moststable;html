        // Linear multi-stop gradient based on strict thresholds: +75 green, +65 yellow, +55 orange, 55> red
        const getVerticalGradient = (chartCtx, chartArea) => {
            if (!chartArea) return '#10b981';
            try {
                const grad = chartCtx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                
                // Scale is exactly 0 to 100. Let's map coordinates:
                // Top (100% marks) is top of chart (0), bottom (0% marks) is bottom (1).
                // So Y ratio = 1 - (Score / 100)
                grad.addColorStop(0, '#10b981');    // 100% -> Green
                grad.addColorStop(0.25, '#10b981'); // 75% -> Green
                grad.addColorStop(0.35, '#10b39a'); // 65% -> lightgreen
                grad.addColorStop(0.45, '#fbbf24'); // 55% -> yellow
                grad.addColorStop(0.70, '#f43f5e'); // Under 55% -> Red
                grad.addColorStop(1, '#f43f5e');    // 0% -> Red
                
                return grad;
            } catch (e) {
                return '#10b981';
            }
        };

