        }

        async function signInWithGoogle() {
            if (authRequestInProgress) return;

            const diagBox = document.getElementById('auth-diagnostics');
            if (diagBox) diagBox.classList.add('hidden');

            if (!supabaseClient) {
                showAuthDiagError(
                    'Initialization Error',
                    'Supabase is not configured. Please set your anon/public key in the application source.'
                );
                return;
            }

            setAuthLoading(true);
            try {
                const redirectTo = window.location.origin + window.location.pathname;

                const { error } = await supabaseClient.auth.signInWithOAuth({
                    provider: 'google',
                    options: {
                        redirectTo
                    }
                });

                if (error) {
                    showAuthDiagError('Google Sign In Failed', error.message);
                    setAuthLoading(false);
                    return;
                }

                // Supabase redirects the browser to Google, then back to this page.
                // Do not hide the auth screen here; the session callback below will
                // restore the session after the redirect.
            } catch (err) {
                console.error('Google authentication failed:', err);
                showAuthDiagError(
                    'Connection Error',
                    'Google sign-in could not be started. Please check your network connection and Supabase OAuth settings.'
                );
                setAuthLoading(false);
            }
        }

        async function handleAuthSubmit(event) {
            event.preventDefault();
            if (authRequestInProgress) return;

            const email = document.getElementById('auth-email').value.trim().toLowerCase();
            const password = document.getElementById('auth-password').value;
            const diagBox = document.getElementById('auth-diagnostics');

            if (diagBox) diagBox.classList.add('hidden');

            if (!supabaseClient) {
                showAuthDiagError('Initialization Error', 'Supabase is not configured. Please set your anon/public key in the application source.');
                return;
            }

            setAuthLoading(true);
            let switchToLoginAfterRequest = false;

            try {
                if (currentAuthMode === 'register') {
                    const name = document.getElementById('auth-name').value.trim() || "Scholar";
                    const course = document.getElementById('auth-course').value;
                    const district = document.getElementById('auth-district').value;
                    const registerGeminiKey = document.getElementById('register-gemini-key').value.trim();

                    const { data, error } = await supabaseClient.auth.signUp({ email, password });
                    if (error) {
                        showAuthDiagError("Registration Failed", error.message);
                        return;
                    }

                    if (data?.user) {
                        const { error: profileErr } = await supabaseClient.from('profiles').upsert([
                            { id: data.user.id, name, year: "2027-08-10", course, district, gemini_api_key: registerGeminiKey }
                        ]);
                        if (profileErr) console.error("Profile load failed:", profileErr);
                    }

                    showAlert("Success!", "Your profile has been created successfully. Please sign in now.");
                    switchToLoginAfterRequest = true;
                } else {
                    const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
                    if (error) {
                        showAuthDiagError("Failed Sign In", error.message);
                        return;
                    }

                    currentUserSession = data.session;
                    setSevenDaySessionExpiry();
                    await loadCloudData();
                    document.getElementById('auth-screen').classList.add('hidden');
                    syncProfileUI();
                    updateCoreStats();
                    showAlert('Cloud Connected', 'Successfully connected to secure data cloud!');
                }
            } catch (err) {
                console.error('Authentication request failed:', err);
                showAuthDiagError("Connection Error", "Secure server call failed. Please verify your network connection.");
            } finally {
                setAuthLoading(false);
                if (switchToLoginAfterRequest) toggleAuthMode('login');
            }
        }

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

