        function typeAIResponse(contentElement, fullText, speed = 8) {
            return new Promise((resolve) => {
                if (!contentElement) {
                    resolve();
                    return;
                }

                const plainText = fullText.replace(/\r/g, '');
                let typed = '';
                let index = 0;
                const cursor = '▌';
                const totalDuration = 4000;
                const intervalSpeed = Math.max(4, Math.min(30, Math.floor(totalDuration / Math.max(plainText.length, 1))));
                const typingInterval = setInterval(() => {
                    if (index < plainText.length) {
                        typed += plainText[index++];
                        contentElement.textContent = typed + cursor;
                        contentElement.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    } else {
                        clearInterval(typingInterval);
                        contentElement.innerHTML = formatMessageText(fullText);
                        contentElement.classList.remove('text-slate-400');
                        contentElement.classList.add('text-slate-300');
                        triggerMathRender(contentElement);
                        resolve();
                    }
                }, intervalSpeed);
            });
        }

