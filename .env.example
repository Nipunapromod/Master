# Use the public Supabase project URL and anon/publishable key only in these NEXT_PUBLIC fields.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix the OpenAI key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: set this to your public application URL for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000